# ==========================================
# Crypto News Analysis Engine - Environment
# Copy this file to `.env` and fill in values
# ==========================================

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- MongoDB (local) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=crypto_news

# ---- AI: Google Gemini (Google AI Studio) ----
GEMINI_API_KEY=
AI_OUTPUT_LANGUAGE=English

# Two models run in parallel; Pro also produces the final combined verdict
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3-flash-preview

# Generation config
GEMINI_TEMPERATURE=1.0
GEMINI_TOP_P=0.95
GEMINI_MAX_OUTPUT_TOKENS=65536
# Thinking depth: HIGH | MEDIUM | LOW | MINIMAL (empty to disable)
GEMINI_THINKING_LEVEL=HIGH
# Enable live Google Search grounding
GEMINI_USE_GOOGLE_SEARCH=true
# On transient errors (429/5xx): retry this many times (short backoff), then fall back to Flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_SECONDS=2.0

# ---- Crawler ----
CRAWL_DEFAULT_DAYS=7
CRAWL_MAX_ARTICLES_PER_SITE=40
CRAWL_REQUEST_TIMEOUT=20
CRAWL_CONCURRENCY=3

# Optional: CryptoPanic API token (enables clean currency-filtered API instead of RSS scraping)
CRYPTOPANIC_API_TOKEN=

# ---- Startup ----
# Seed default symbols (BTC, ETH) on first boot
SEED_DEFAULT_SYMBOLS=true
