# ==========================================
# Crypto News Analysis Engine - Environment
# Copy this file to `.env` and fill in values
# ==========================================

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- MongoDB (local) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=crypto_news

# ---- AI provider selection: openai | anthropic ----
AI_PROVIDER=openai
AI_OUTPUT_LANGUAGE=English
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.3

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---- Crawler ----
CRAWL_DEFAULT_DAYS=7
CRAWL_MAX_ARTICLES_PER_SITE=40
CRAWL_REQUEST_TIMEOUT=20
CRAWL_CONCURRENCY=3

# Optional: CryptoPanic API token (enables clean currency-filtered API instead of RSS scraping)
CRYPTOPANIC_API_TOKEN=

# ---- Startup ----
# Seed default symbols (BTC, ETH) on first boot
SEED_DEFAULT_SYMBOLS=true
